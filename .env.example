# Copy this file to .env (git-ignored) and fill in the values you need.
# `npm run dev` and `npm start` load .env through Node's --env-file-if-exists, so no
# dotenv dependency is involved; an `export` in your shell wins over the value in .env.
# A missing .env is not an error — the server starts and the `adk` driver degrades to
# deterministic mode (src/services/genai.ts). `npm test` deliberately loads no .env.

# Google Gemini API key for ADK root agent
# Get yours at https://makersuite.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your_api_key_here

# Express API port — 3123 (the Vite dev server uses 3130; 3000-3002 are reserved by other services)
PORT=3123

# Optional Gemini guards — defaults shown, uncomment to override
# GEMINI_RATE_LIMIT_PER_MINUTE=60
# GEMINI_CACHE_TTL_MS=300000
# GEMINI_CACHE_MAX_SIZE=100
